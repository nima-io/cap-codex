{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node", "@sap/cds"]
  },
  "include": ["srv/**/*.ts", "test/**/*.ts"],
  "exclude": ["node_modules"]
}
