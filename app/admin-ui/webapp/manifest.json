{
  "sap.app": {
    "id": "admin.ui",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "1.0.0"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "dataSources": {
      "mainService": {
        "uri": "/admin/",
        "type": "OData",
        "settings": {
          "odataVersion": "4.0"
        }
      }
    }
  },
  "sap.ui5": {
    "dependencies": {
      "minUI5Version": "1.120.0",
      "libs": {
        "sap.m": {},
        "sap.fe.templates": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "synchronizationMode": "None",
          "operationMode": "Server",
          "autoExpandSelect": true
        }
      },
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "admin.ui.i18n.i18n"
        }
      }
    },
    "routing": {
      "config": {
        "routerClass": "sap.fe.core.Router",
        "controlId": "app",
        "controlAggregation": "pages",
        "viewPath": "sap.fe.templates",
        "async": true
      },
      "routes": [
        {
          "name": "BooksList",
          "pattern": ":?query:",
          "target": "BooksList"
        },
        {
          "name": "AuthorsList",
          "pattern": "Authors:?query:",
          "target": "AuthorsList"
        },
        {
          "name": "AuthorsObjectPage",
          "pattern": "Authors({key}):?query:",
          "target": "AuthorsObjectPage"
        },
        {
          "name": "BooksList",
          "pattern": "Books:?query:",
          "target": "BooksList"
        },
        {
          "name": "BooksObjectPage",
          "pattern": "Books({key}):?query:",
          "target": "BooksObjectPage"
        },
        {
          "name": "CustomersList",
          "pattern": "Customers:?query:",
          "target": "CustomersList"
        },
        {
          "name": "CustomersObjectPage",
          "pattern": "Customers({key}):?query:",
          "target": "CustomersObjectPage"
        },
        {
          "name": "OrdersList",
          "pattern": "Orders:?query:",
          "target": "OrdersList"
        },
        {
          "name": "OrdersObjectPage",
          "pattern": "Orders({key}):?query:",
          "target": "OrdersObjectPage"
        },
        {
          "name": "OrderItemsList",
          "pattern": "OrderItems:?query:",
          "target": "OrderItemsList"
        },
        {
          "name": "OrderItemsObjectPage",
          "pattern": "OrderItems({key}):?query:",
          "target": "OrderItemsObjectPage"
        },
        {
          "name": "ReturnsList",
          "pattern": "Returns:?query:",
          "target": "ReturnsList"
        },
        {
          "name": "ReturnsObjectPage",
          "pattern": "Returns({key}):?query:",
          "target": "ReturnsObjectPage"
        },
        {
          "name": "PublishersList",
          "pattern": "Publishers:?query:",
          "target": "PublishersList"
        },
        {
          "name": "PublishersObjectPage",
          "pattern": "Publishers({key}):?query:",
          "target": "PublishersObjectPage"
        },
        {
          "name": "CategoriesList",
          "pattern": "Categories:?query:",
          "target": "CategoriesList"
        },
        {
          "name": "CategoriesObjectPage",
          "pattern": "Categories({key}):?query:",
          "target": "CategoriesObjectPage"
        },
        {
          "name": "FormatsList",
          "pattern": "Formats:?query:",
          "target": "FormatsList"
        },
        {
          "name": "FormatsObjectPage",
          "pattern": "Formats({key}):?query:",
          "target": "FormatsObjectPage"
        },
        {
          "name": "TagsList",
          "pattern": "Tags:?query:",
          "target": "TagsList"
        },
        {
          "name": "TagsObjectPage",
          "pattern": "Tags({key}):?query:",
          "target": "TagsObjectPage"
        },
        {
          "name": "ReviewsList",
          "pattern": "Reviews:?query:",
          "target": "ReviewsList"
        },
        {
          "name": "ReviewsObjectPage",
          "pattern": "Reviews({key}):?query:",
          "target": "ReviewsObjectPage"
        },
        {
          "name": "PromotionsList",
          "pattern": "Promotions:?query:",
          "target": "PromotionsList"
        },
        {
          "name": "PromotionsObjectPage",
          "pattern": "Promotions({key}):?query:",
          "target": "PromotionsObjectPage"
        }
      ],
      "targets": {
        "AuthorsList": {
          "type": "Component",
          "id": "AuthorsList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "entitySet": "Authors",
              "variantManagement": true
            }
          }
        },
        "AuthorsObjectPage": {
