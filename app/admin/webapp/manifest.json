{
  "sap.app": {
    "id": "admin",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "title": "{{title}}",
    "dataSources": {
      "adminService": {
        "uri": "/odata/v4/admin/",
        "type": "OData",
        "settings": {
          "odataVersion": "4.0"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5"
  },
  "sap.ui5": {
    "dependencies": {
      "minUI5Version": "1.120.0",
      "libs": {
        "sap.m": {},
        "sap.ui.layout": {},
        "sap.f": {}
      }
    },
    "models": {
      "": {
        "dataSource": "adminService",
        "settings": {
          "synchronizationMode": "None",
          "operationMode": "Server",
          "groupId": "$auto",
          "autoExpandSelect": true
        }
      },
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "admin.i18n.i18n"
        }
      }
    },
    "rootView": {
      "viewName": "admin.view.App",
      "type": "XML",
      "async": true,
      "id": "app"
    },
    "routing": {
      "config": {
        "routerClass": "sap.f.routing.Router",
        "viewType": "XML",
        "viewPath": "admin.view",
        "controlId": "fcl",
        "controlAggregation": "beginColumnPages",
        "async": true
      },
      "routes": [
        {
          "pattern": "",
          "name": "main",
          "target": ["Main"],
          "layout": "OneColumn"
        },
        {
          "pattern": "Books/{ID}",
          "name": "bookDetail",
          "target": ["Main", "Book"],
          "layout": "TwoColumnsMidExpanded"
        },
        {
          "pattern": "Books/create",
          "name": "bookCreate",
          "target": ["Main", "Book"],
          "layout": "TwoColumnsMidExpanded"
        }
      ],
      "targets": {
        "Main": {
          "viewName": "Main",
          "controlAggregation": "beginColumnPages"
        },
        "Book": {
          "viewName": "Book",
          "viewId": "book",
          "controlAggregation": "midColumnPages"
        }
      }
    }
  }
}

