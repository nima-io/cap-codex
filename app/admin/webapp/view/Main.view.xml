<mvc:View
  controllerName="admin.controller.Main"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:core="sap.ui.core">
  <Page title="{i18n>title}">
    <headerContent>
      <Button text="{i18n>save}" press=".onSave" />
    </headerContent>
    <content>
      <IconTabBar expandable="false">
        <items>
              <IconTabFilter text="{i18n>authors}" key="authors">
                <Table items="{/Authors}">
                  <columns>
                    <Column><Text text="ID"/></Column>
                    <Column><Text text="{i18n>name}"/></Column>
                  </columns>
                  <items>
                    <ColumnListItem>
                      <cells>
                        <Text text="{ID}"/>
                        <Text text="{name}"/>
                      </cells>
                    </ColumnListItem>
                  </items>
                </Table>
              </IconTabFilter>
              <IconTabFilter text="{i18n>books}" key="books">
                <Table id="booksTable" items="{/Books}">
                  <headerToolbar>
                    <Toolbar>
                      <Title text="{i18n>books}"/>
                      <ToolbarSpacer/>
                      <Button icon="sap-icon://add" tooltip="{i18n>add}" press=".onAddBook"/>
                    </Toolbar>
                  </headerToolbar>
                  <columns>
                    <Column><Text text="ID"/></Column>
                    <Column><Text text="{i18n>titleColumn}"/></Column>
                    <Column><Text text="{i18n>stock}"/></Column>
                    <Column><Text text="{i18n>price}"/></Column>
                    <Column><Text text="{i18n>author}"/></Column>
                    <Column><Text text="{i18n>publisher}"/></Column>
                    <Column><Text text="{i18n>category}"/></Column>
                    <Column><Text text="{i18n>format}"/></Column>
                    <Column><Text text="{i18n>isFeatured}"/></Column>
                    <Column><Text text="{i18n>bestsellerRank}"/></Column>
                  </columns>
                  <items>
                    <ColumnListItem type="Navigation" press=".onBookPress">
                      <cells>
                        <Text text="{ID}"/>
                        <Text text="{title}"/>
                        <Input value="{stock}" type="Number" />
                        <Input value="{ path: 'price', type: 'sap.ui.model.odata.type.Decimal', targetType:'string', constraints:{ precision:9, scale:2 } }"/>
                        <Text text="{author/name}"/>
                        <Text text="{publisher/name}"/>
                        <Text text="{category/name}"/>
                        <Text text="{format/name}"/>
                        <CheckBox selected="{isFeatured}"/>
                        <Text text="{bestsellerRank}"/>
                      </cells>
                    </ColumnListItem>
                  </items>
                </Table>
              </IconTabFilter>
              <IconTabFilter text="{i18n>customers}" key="customers">
                <Table items="{/Customers}">
                  <columns>
                    <Column><Text text="ID"/></Column>
                    <Column><Text text="{i18n>name}"/></Column>
                  </columns>
                  <items>
                    <ColumnListItem>
                      <cells>
                        <Text text="{ID}"/>
                        <Text text="{name}"/>
                      </cells>
                    </ColumnListItem>
                  </items>
                </Table>
              </IconTabFilter>
              <IconTabFilter text="{i18n>orders}" key="orders">
                <Table items="{/Orders}">
                  <columns>
                    <Column><Text text="ID"/></Column>
                    <Column><Text text="{i18n>customer}"/></Column>
                    <Column><Text text="{i18n>status}"/></Column>
                  </columns>
                  <items>
                    <ColumnListItem>
                      <cells>
                        <Text text="{ID}"/>
                        <Text text="{customer_ID}"/>
                        <Select selectedKey="{status}">
                          <items>
                            <core:Item key="NEW" text="{i18n>statusNew}"/>
                            <core:Item key="PROCESSING" text="{i18n>statusProcessing}"/>
                            <core:Item key="SHIPPED" text="{i18n>statusShipped}"/>
                            <core:Item key="CANCELLED" text="{i18n>statusCancelled}"/>
                          </items>
                        </Select>
                      </cells>
                    </ColumnListItem>
                  </items>
                </Table>
              </IconTabFilter>
            </items>
          </IconTabBar>
        </content>
      </Page>
</mvc:View>
